# Table settings for the full-scale load
# ("Assumptions" in the root README).
# Reference only: not meant to be applied.
# What they cost: "Cost" in infra/README.md.
# The table is on-demand, so it needs no sizing.
# App settings: infra/app/full-scale.tfvars.example
table_point_in_time_recovery = true
table_deletion_protection    = true
