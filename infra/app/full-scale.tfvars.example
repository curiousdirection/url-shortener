# App settings for the full-scale load ("Assumptions" in the root README).
# Reference only: not meant to be applied.
# What they cost: "Cost" in infra/README.md.
# Table settings: infra/foundation/full-scale.tfvars.example
system_log_level = "WARN"

# CloudFront's access logs (see the variable).
cdn_access_logs = false

# Rate limits by IP (AWS WAF).
rate_limiting = true

# Origin Shield (see the variable).
origin_shield_region = "eu-west-2"

# About 20 times the average load: about 1,300 requests a second miss the cache and, at a guessed 20 ms each, keep about 25 copies busy.
reserved_concurrency = 500
