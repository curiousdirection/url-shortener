# Full-scale function settings for the load in "Assumptions" (root README.md). Reference only,
# not meant to be applied; see "Cost" in ../README.md. The table settings are in
# ../foundation/full-scale.tfvars.example.
memory_size = 512

# Rate limits by IP (AWS WAF). Off for practice, where WAF would cost about $7 a month.
rate_limiting = true

# Origin Shield in the region AWS pairs with eu-north-1 (see the variable's description).
origin_shield_region = "eu-west-2"
