# Full-scale sizing: 1B stored URLs, ~35k redirects/s at peak. Reference only, not meant to be applied
# (about $4,000/month). Same structure as practice; only these values differ.
budget_alert_email = "you@example.com"
budget_limit_usd   = "4500"

instance_type = "c7g.large"
asg_min       = 2
asg_max       = 12
asg_desired   = 4

db_instance_class        = "db.r7g.large"
db_allocated_storage     = 300
db_multi_az              = true
db_backup_retention_days = 7
db_deletion_protection   = true
db_skip_final_snapshot   = false
