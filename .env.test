# Used by `npm test` and `npm run db:setup:test`.
# Tests empty the table, so keep this separate from dev.
# The keys are dummies: DynamoDB Local doesn't check them, but
# the SDK wants some.
TABLE_NAME=urls_test
DYNAMODB_ENDPOINT=http://localhost:8001
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
